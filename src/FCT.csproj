<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows app: the standby process has no window; the tool opens its own console (NativeConsole). -->
    <OutputType>WinExe</OutputType>
    <!-- Windows.Graphics.Capture reads the post-match treasure screen from the game window: runs on Windows 10 2004+,
         built against the Windows 11 SDK (borderless capture where available). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- FCT.exe; Windows shows the long name (Task Manager, file properties). -->
    <AssemblyName>FCT</AssemblyName>
    <Product>Fortnite Chest Tracker</Product>
    <AssemblyTitle>Fortnite Chest Tracker</AssemblyTitle>
    <!-- Shown in the file properties (and required by SignPath: product name and version in the metadata). -->
    <Description>Fortnite Chest Tracker - counts the chests you open in Fortnite from its replays. Not affiliated with Epic Games.</Description>
    <Company>Fortnite Chest Tracker</Company>
    <Authors>adrc4-ua</Authors>
    <Copyright>Copyright (C) 2026 Adrián Ruiz. GPL-3.0-only with additional terms (NOTICE.md). Fortnite is a trademark of Epic Games, Inc.</Copyright>
    <RootNamespace>FCT</RootNamespace>
    <Version>5.7.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Single-file publish: the parser discovers its types by reflection, so no trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Small idle footprint: workstation, non-concurrent GC (no background GC thread) and a GC that gives memory back. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also inside the exe as a resource: the stats page shows it as its logo. -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="FCT.app.ico" />
    <!-- Style and script of the stats page and of the OBS overlay (written into each page). -->
    <EmbeddedResource Include="Stats\Page\*.css;Stats\Page\*.js" LogicalName="FCT.page.%(Filename)%(Extension)" />
    <!-- The license and the third-party notices travel with the exe (the GPL and MIT ask for it); the exe prints them with its licenses option. -->
    <EmbeddedResource Include="..\NOTICE.md" LogicalName="FCT.NOTICE.md" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="FCT.LICENSE" />
    <EmbeddedResource Include="..\THIRD_PARTY_NOTICES.md" LogicalName="FCT.THIRD_PARTY_NOTICES.md" />
    <!-- Languages besides Spanish and English: one JSON file per language. -->
    <EmbeddedResource Include="Localization\Languages\*.json" LogicalName="FCT.lang.%(Filename).json" />
    <!-- fortnite-api.com key to look up the player's total matches (estimate of the chests before FCT). It comes from
         the FORTNITE_API_KEY environment variable (a GitHub secret in the release build); empty = typed by hand. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FortniteApiKey</_Parameter1>
      <_Parameter2>$(FORTNITE_API_KEY)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!-- FCT's replay models are their own assembly (see ReplayModels/): not compiled into FCT.exe's. -->
    <Compile Remove="ReplayModels\**" />
    <None Remove="ReplayModels\**" />
    <ProjectReference Include="ReplayModels\FCT.ReplayReader.Models.csproj" />
    <ProjectReference Include="..\external\FortniteReplayDecompressor\FortniteReplayReader\FortniteReplayReader.csproj" />
  </ItemGroup>
</Project>
